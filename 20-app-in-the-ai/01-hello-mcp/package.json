{
  "name": "hello-mcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minimaler MCP-Server (Spec 2026-07-28): ein Tool, ein Resource, ein Prompt; stdio und Streamable HTTP",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/http.ts",
    "start": "node src/http.ts",
    "client": "node src/client.ts",
    "curl": "sh scripts/curl-demo.sh",
    "inspector": "npx @modelcontextprotocol/inspector@latest --web --config inspector.json",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
